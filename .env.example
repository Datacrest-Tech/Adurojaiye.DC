# ─────────────────────────────────────────────────────────────────────────
# This file is read ONLY by the Express server (server/index.js), via
# `import 'dotenv/config'`. Nothing here is bundled into the React app —
# none of these variables are prefixed with VITE_, so Vite will never expose
# them to client-side code. Copy this file to `.env` and fill in real values.
# `.env` is already git-ignored.
# ─────────────────────────────────────────────────────────────────────────

# Node environment. Use "production" when running `npm run build && npm start`
# so Express also serves the built React app (see server/index.js).
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Only needed if you ever host the frontend on a different origin than the
# API (e.g. a separate static host). Not required for the default setup,
# where Express serves both the API and the built site from one origin.
# CORS_ORIGIN=http://localhost:5173

# ── SMTP (used by Nodemailer to send the Contact/Consult form emails) ──────
# Example values for common providers:
#   Gmail:        host=smtp.gmail.com        port=587  secure=false (use an App Password)
#   Outlook/365:  host=smtp.office365.com     port=587  secure=false
#   Zoho:         host=smtp.zoho.com          port=465  secure=true
#   SendGrid:     host=smtp.sendgrid.net      port=587  secure=false (user="apikey")
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for port 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password

# Address emails are sent FROM (often must match/relate to SMTP_USER)
MAIL_FROM="ADC Website <no-reply@adurojaiye.com>"

# Address(es) that receive form submissions — comma-separated for multiple.
# The live site's contact endpoint is info@adurojaiye.com.
MAIL_TO=info@adurojaiye.com
